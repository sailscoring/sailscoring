{
  "firewallEnabled": true,
  "managedRules": {
    "ai_bots": {
      "active": true,
      "action": "deny"
    },
    "bot_protection": {
      "active": true,
      "action": "challenge"
    }
  },
  "crs": {
    "gen": { "active": false, "action": "log" },
    "sd": { "active": false, "action": "log" },
    "java": { "active": false, "action": "log" },
    "sf": { "active": false, "action": "log" },
    "ma": { "active": false, "action": "log" },
    "rfi": { "active": false, "action": "log" },
    "rce": { "active": false, "action": "log" },
    "xss": { "active": false, "action": "log" },
    "php": { "active": false, "action": "log" },
    "lfi": { "active": false, "action": "log" },
    "sqli": { "active": false, "action": "log" }
  },
  "ips": [],
  "rules": [
    {
      "name": "Bypass: keyed API clients",
      "description": "The CLI and other API-key clients call /api/v1 from scripts that cannot answer Bot Protection's JavaScript challenge.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            { "type": "path", "op": "pre", "value": "/api/v1/" },
            { "type": "header", "op": "ex", "key": "authorization" }
          ]
        }
      ],
      "action": { "mitigate": { "action": "bypass" } }
    },
    {
      "name": "Bypass: OAuth endpoints apps and the CLI call",
      "description": "ADR-016: the token, revocation and device-code endpoints, the discovery document, and the CLI's client-id lookup are called by app servers and `sailscoring auth login`, which cannot answer Bot Protection's JavaScript challenge. The pages a person signs in and approves on stay protected.",
      "active": true,
      "conditionGroup": [
        { "conditions": [{ "type": "path", "op": "eq", "value": "/api/auth/oauth2/token" }] },
        { "conditions": [{ "type": "path", "op": "eq", "value": "/api/auth/oauth2/revoke" }] },
        { "conditions": [{ "type": "path", "op": "eq", "value": "/api/auth/device/code" }] },
        { "conditions": [{ "type": "path", "op": "eq", "value": "/.well-known/oauth-authorization-server" }] },
        { "conditions": [{ "type": "path", "op": "eq", "value": "/api/cli/client" }] }
      ],
      "action": { "mitigate": { "action": "bypass" } }
    },
    {
      "name": "Bypass: Vercel cron",
      "description": "Scheduled sweeps declared in vercel.json.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            { "type": "path", "op": "pre", "value": "/api/cron/" }
          ]
        }
      ],
      "action": { "mitigate": { "action": "bypass" } }
    },
    {
      "name": "Bypass: health check",
      "description": "Uptime monitoring and the post-deploy check in DEPLOY.md.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            { "type": "path", "op": "eq", "value": "/api/health" }
          ]
        }
      ],
      "action": { "mitigate": { "action": "bypass" } }
    },
    {
      "name": "Bypass: published data sidecars",
      "description": "A published series' .sailscoring.json data file (ADR-012), fetched by programs.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            { "type": "path", "op": "pre", "value": "/p/" },
            { "type": "path", "op": "suf", "value": ".sailscoring.json" }
          ]
        }
      ],
      "action": { "mitigate": { "action": "bypass" } }
    },
    {
      "name": "Bypass: published indexes",
      "description": "The machine-readable indexes of published results (ADR-014): /p/index.json, /p/{ws}/index.json and /p/{ws}/{season}/index.json.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            { "type": "path", "op": "pre", "value": "/p/" },
            { "type": "path", "op": "suf", "value": "/index.json" }
          ]
        }
      ],
      "action": { "mitigate": { "action": "bypass" } }
    },
    {
      "name": "Rate limit: published results API",
      "description": "Off until usage shows abuse (ADR-015, section 7): the WAF meters every request a rate-limit rule inspects, cached ones included. Generous when on, as a clubhouse's phones share one address. Ahead of the API's bypass, which would end evaluation first. The publications part only: the authenticated calls beside it have per-grant limits (ADR-016).",
      "active": false,
      "conditionGroup": [
        {
          "conditions": [
            { "type": "path", "op": "pre", "value": "/api/public/v1/publications/" }
          ]
        }
      ],
      "action": {
        "mitigate": {
          "action": "rate_limit",
          "rateLimit": { "algo": "fixed_window", "window": 60, "limit": 600, "keys": ["ip"], "action": "deny" }
        }
      }
    },
    {
      "name": "Bypass: published results API",
      "description": "The published results API (ADR-015) under /api/public/: unauthenticated JSON for race-day apps and clubhouse screens, which cannot answer Bot Protection's JavaScript challenge.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            { "type": "path", "op": "pre", "value": "/api/public/" }
          ]
        }
      ],
      "action": { "mitigate": { "action": "bypass" } }
    },
    {
      "name": "Bypass: link previewers",
      "description": "Chat and social apps fetching a shared results link to build its preview card.",
      "active": true,
      "conditionGroup": [
        {
          "conditions": [
            {
              "type": "user_agent",
              "op": "re",
              "value": "(WhatsApp|facebookexternalhit|Facebot|Slackbot|Twitterbot|Discordbot|TelegramBot)"
            },
            {
              "type": "path",
              "op": "inc",
              "value": ["/opengraph-image.png", "/icon.svg", "/apple-icon.png", "/favicon.ico"]
            }
          ]
        },
        {
          "conditions": [
            {
              "type": "user_agent",
              "op": "re",
              "value": "(WhatsApp|facebookexternalhit|Facebot|Slackbot|Twitterbot|Discordbot|TelegramBot)"
            },
            { "type": "path", "op": "pre", "value": "/p/" }
          ]
        }
      ],
      "action": { "mitigate": { "action": "bypass" } }
    }
  ]
}
